{
  "name": "haohao-chifan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:unit": "node --test tests/*.test.ts",
    "test:contracts": "node --test tests/*.test.mjs",
    "test:ui": "node tests/e2e/ui-smoke.mjs",
    "test": "npm run test:unit && npm run test:contracts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext --ignore-pattern .wrangler --ignore-pattern outputs --ignore-pattern work",
    "verify": "npm test && npm run typecheck && npm run build && npm run lint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.11",
    "pg": "8.22.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "redis": "6.1.0",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
